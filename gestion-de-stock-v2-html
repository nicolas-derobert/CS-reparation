            };

            return (
                <div className="app">
                    <Sidebar page={page} setPage={setPage} ouvert={ouvert} fermer={() => setOuvert(false)} />
                    <div className="main">
                        <Entete page={page} ouvrir={() => setOuvert(true)} />
                        <div className="contenu">{rendu()}</div>
                        <footer className="pied">
                            <span>École d'Horlogerie de Genève — CPH_HO_02 · CS : de l'accueil à la livraison</span>
                            <span>Objectif évaluateur 5.6.6 — gestion d'un stock et de son flux · Application v4</span>
                        </footer>
                    </div>
                </div>
            );
        };

        createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>